{
  // Official News backend: one Worker serves the API and runs the scheduled job.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // NewsApp account (see docs/setup.md). Not a secret.
  "account_id": "8dc93578877d397a693094f3e2b01029",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "official-news",
      "database_id": "67052e61-5544-4c6d-a182-1321192f3d0a",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI writes the article summaries (item 7, docs/style-guide.md).
  "ai": { "binding": "AI" },
  // The fetcher every minute, the summarizer every odd minute and the
  // translator (#46) every even minute, each in its own run (CRONS in
  // src/index.ts; a test checks they match). Groq's key for the translator is
  // the Worker secret GROQ_API_KEY, never in this file.
  "triggers": { "crons": ["* * * * *", "1-59/2 * * * *", "0-58/2 * * * *"] },
  "observability": { "enabled": true }
}
