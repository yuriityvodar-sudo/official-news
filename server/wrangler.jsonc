{
  // Official News backend: one Worker serves the API and runs the scheduled job.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // NewsApp account (see docs/setup.md). Not a secret.
  "account_id": "8dc93578877d397a693094f3e2b01029",
  // The API only at api.outernews.app (S2 of the release audit), where the
  // zone's rate limiting rule stands in front of the Worker: no workers.dev
  // copy past that rule, since 5 Nov (docs/setup.md).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.outernews.app", "custom_domain": true }],
  // At most API_LIMIT (src/api/index.ts) requests a minute from one address in
  // a Cloudflare location, answered 429 before they read D1.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "official-news",
      "database_id": "67052e61-5544-4c6d-a182-1321192f3d0a",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI writes the article summaries (item 7, docs/style-guide.md).
  "ai": { "binding": "AI" },
  // The fetcher every minute, the summarizer every odd minute and the translator
  // every even minute, each in its own run, and the cleanup of old texts once a day
  // at 03:17 UTC (CRONS in src/index.ts; a test checks they match). A new schedule
  // can take about an hour to start firing (#50).
  "triggers": { "crons": ["* * * * *", "1-59/2 * * * *", "0-58/2 * * * *", "17 3 * * *"] },
  "observability": { "enabled": true },
  // Workers Caching (#121): Cloudflare's cache in front of the Worker keeps what the API
  // marks with Cache-Control (LIST_CACHE and ARTICLE_CACHE in src/api/index.ts).
  "cache": { "enabled": true }
}
