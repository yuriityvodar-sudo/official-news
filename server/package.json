{
  "name": "official-news-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply official-news --local",
    "db:migrate:remote": "wrangler d1 migrations apply official-news --remote",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
