# Local secrets: copy to .dev.vars (git ignores it) and fill in. Never commit a value.
# The deployed Worker gets its own with `npx wrangler secret put <NAME>` (docs/setup.md).

# Groq, for the translations (#46). Read by the local Worker (`npm run dev`: the
# translator, empty means it skips its runs) and by scripts/translate-test.mjs (SET=groq).
GROQ_API_KEY=
