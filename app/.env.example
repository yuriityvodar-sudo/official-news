# Local build settings: copy to .env (git ignores it) and fill in. Never commit a value.
# Read by `flutter run --dart-define-from-file=.env` (docs/setup.md).

# Opens the AI chat to Sandbox purchases on Roman's own builds (#146): the same
# value as the Worker secret CHAT_SANDBOX_KEY. Empty means the chat stays closed.
CHAT_SANDBOX_KEY=
